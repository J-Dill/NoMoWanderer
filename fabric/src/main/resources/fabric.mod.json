{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "nomowanderer.NoMoWandererFabricMod"
    ],
    "client": [
      "nomowanderer.NoMoWandererFabricClientMod"
    ],
    "fabric-gametest": [
      "nomowanderer.CommonGameTests"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.3",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=17"
  }
}